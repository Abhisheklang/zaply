# Build environment for Zaply's Linux packages.
#
# Based on Ubuntu 20.04 so the produced binaries link against glibc 2.31
# and run on older distributions than the GitHub runner itself. The image
# only carries a current CMake (from Kitware's repository, because the
# distribution CMake is too old for some bundled dependencies) and
# sccache. Everything else - the Rust toolchain, clang 18, lld 18 and a
# modern libstdc++ - is installed at build time by script/linux, which
# already knows how to set up Ubuntu 20.04 using the ubuntu-toolchain-r
# PPA.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg git lsb-release sudo \
      pkg-config perl python3 nasm unzip file \
 && curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
      | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
 && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ focal main' \
      > /etc/apt/sources.list.d/kitware.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends cmake \
 && rm -rf /var/lib/apt/lists/*

# sccache, using the GitHub Actions cache backend. The cache credentials
# are passed in when the container runs; nothing secret is baked into
# the image.
ARG SCCACHE_VERSION=0.8.2
RUN curl -fsSL "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 \
          "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" \
 && chmod +x /usr/local/bin/sccache
