<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>Fast, open source code editor with a built-in AI agent panel</summary>
    <developer id="io.github.Abhisheklang">
        <name translate="no">Zaply Contributors</name>
    </developer>
    <description>
        <p>
            Zaply is a fast, open source code editor built for speed. It blends the power of an IDE with the responsiveness of a lightweight editor, and it never asks you to create an account.
        </p>
        <p>Features:</p>
        <ul>
            <li>Performance: GPU-accelerated rendering and efficient use of every CPU core for instant startup, quick file loading, and responsive keystrokes.</li>
            <li>Language-aware: Maintains a syntax tree for precise highlighting and auto-indent, with LSP support for autocompletion and refactoring.</li>
            <li>AI agent panel: Work with the AI provider you choose, using your own API key or a local model. No account and no telemetry.</li>
        </ul>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1">
        <content_attribute id="social-chat">none</content_attribute>
        <content_attribute id="social-audio">none</content_attribute>
    </content_rating>

    <url type="homepage">https://github.com/Abhisheklang/zaply</url>
    <url type="bugtracker">https://github.com/Abhisheklang/zaply/issues</url>
    <url type="help">https://github.com/Abhisheklang/zaply/tree/main/docs</url>
    <url type="vcs-browser">https://github.com/Abhisheklang/zaply</url>
    <url type="contribute">https://github.com/Abhisheklang/zaply/blob/main/CONTRIBUTING.md</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>

    <releases>
		@release_info@
		<release version="0.0.0" date="1970-01-01">
			<description>
				<p>Dummy release to keep flatpak-builder AppStream metadata validation from complaining</p>
			</description>
		</release>
    </releases>
</component>
