#!/usr/bin/env bash

set -euxo pipefail

if [[ $# -gt 0 ]]; then
  echo "
  Usage: ${0##*/}
  Builds and installs zaply onto your system into ~/.local, making it available as ~/.local/bin/zaply.

  Before running this you should ensure you have all the build dependencies installed with `./script/linux`.
  "
  exit 1
fi
export ZAPLY_CHANNEL=$(<crates/zaply/RELEASE_CHANNEL)
export ZAPLY_UPDATE_EXPLANATION="You need to fetch and rebuild zaply in $(pwd)"
script/bundle-linux

arch="$(uname -m)"
commit=$(git rev-parse HEAD | cut -c 1-7)
archive="zaply-linux-${arch}.tar.gz"
export ZAPLY_BUNDLE_PATH="${CARGO_TARGET_DIR:-target}/release/${archive}"
script/install.sh
